# Copy to .env locally. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO

# Model bundle (Phase 10+)
MODEL_BUNDLE_PATH=models/bundles/simple_cnn-1.0.1
# CIFAR_CNN_BUNDLE_HMAC_KEY=

# OIDC (Phase 11+)
# static = HS256 test tokens (dev/CI only); jwks = production RS256 via JWKS URL
CIFAR_CNN_OIDC_MODE=static
OIDC_ISSUER=https://cifar-cnn.local/test
OIDC_AUDIENCE=cifar-cnn-api
# OIDC_JWKS_URL=
CIFAR_CNN_OIDC_HS256_SECRET=cifar-cnn-test-hs256-not-for-production

# Abuse controls
CIFAR_CNN_MAX_UPLOAD_BYTES=1000000
CIFAR_CNN_RATE_LIMIT_PER_MIN=60
CIFAR_CNN_PREDICT_TIMEOUT_SEC=5
CIFAR_CNN_TOP_K_MAX=5
# Never enable in production without formal risk acceptance
CIFAR_CNN_ALLOW_ANON_PREDICT=false
CIFAR_CNN_AUTH_READY=false
